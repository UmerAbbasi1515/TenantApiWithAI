@model EitsalatRegTry.DTO.Finalize.Transaction
@{
    string ResponseCode = ViewBag.ResponseCode;
}
<link rel="stylesheet" type="text/css" href="~/tenant01/assets/css/Finlize.css" />
@*<h2>RS: @ResponseCode</h2>
@ViewBag.RawResult*@


<body>
    @if (ResponseCode == "0")
    {
        <section>
            <div>
                <img src="~/tenant01/assets/Success_message.jpg">
                <h2>Thank you!</h2>
                 <p>
                    Your payment has been completed successfully.<br> <strong> Reference No. @ViewBag.TransactionID</strong>
                </p>
            </div>
        </section>
    }
    else
    {
        <section>
            <div>
                <h2>Payment Failed!</h2>
                <p>
                   Your payment could not been completed. Please try again, later <br>
                </p>
            </div>
        </section>
    }

</body>



