@model FABTenantApi.Models.InvoiceVm
<html xmlns="http://www.w3.org/1999/xhtml">


<body style="margin: 5px">
    <form id="form1" runat="server">

        <div>
            <table style="width: 100%">


                <tr>
                    <td colspan="2" style="height: 80px" align="center">
                        &nbsp;
                        @if (@Model.logo != null)
                        {
                            string imreBase64Data = Convert.ToBase64String(Model.logo);
                            <img  alt="header file missing" runat="server" src="@string.Format("data:image/jpg;base64,{0}", imreBase64Data)">
                        }

                        @*<img alt="header file missing" runat="server" src="data:image/png;base64," />*@
                    </td>

                </tr>
                <tr>
                    <td width="70%">
                        &nbsp;
                    </td>
                    <td style="line-height: 25px">
                        <table>
                            <tr>
                                <td style="width: 80px"><b>Receipt No.</b></td>
                                <td>
                                    :&nbsp;&nbsp;
                                    <asp:Label ID="" Style="border-bottom: 1px dotted grey" runat="server">@Model.Transaction.TransactionNo</asp:Label>
                                </td>
                            </tr>
                        </table>


                    </td>
                </tr>
                <tr>
                    <td style="line-height: 25px">
                        <b>Mode of Payment:</b>
                        <asp:Label ID="" Style="border-bottom: 1px dotted grey" runat="server">@Model.Transaction.PaymentKind</asp:Label>
                    </td>
                    <td style="line-height: 30px">
                        <table>
                            <tr>
                                <td style="width: 80px"><b>Date</b></td>
                                <td>
                                    :&nbsp;&nbsp;
                                    <asp:Label ID="" Style="border-bottom: 1px dotted grey" runat="server">@Model.Transaction.TransactionDate</asp:Label>
                                </td>
                            </tr>
                        </table>

                    </td>
                </tr>
                <tr>
                    <td>
                        &nbsp;
                    </td>
                    <td style="line-height: 25px">
                        <table>
                            <tr>
                                <td style="width: 80px"><b>AED</b> </td>
                                <td>
                                    :&nbsp;&nbsp;
                                    <asp:Label ID="" Style="border-bottom: 1px dotted grey" runat="server">@Model.Transaction.PaymentAmount</asp:Label>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>

                    <td colspan="2" style="line-height: 30px">
                        <b>Received with thanks from:</b>&nbsp;<asp:Label ID="@Model.Transaction.PayeeName" runat="server"></asp:Label>@Model.Transaction.PayeeName.,<br />
                        <asp:Label ID="lblAmountinWords" runat="server"></asp:Label><br />For;
                        <asp:Label ID="lblReasonofpayment" runat="server"></asp:Label>
                        <hr style="border-bottom: 1px solid black !important;">
                    </td>

                </tr>


            </table>
            <table cellpadding="2" cellspacing="2" border="0" width="100%">

                <tr>
                    <td style="width: 50px; border-bottom: 1px solid black !important">
                        <b>TOWARDS:</b>

                    </td>
                    <td colspan="3" align="right">
                        <b>
                            <asp:Label ID="" runat="server" Style="color: Gray" CssClass="textstyle">@Model.Transaction.PrintStatus</asp:Label>
                        </b>
                    </td>

                </tr>
                <tr>
                    <td style="line-height: 20px">
                        <b>Property</b>
                    </td>
                    <td>
                        :&nbsp;&nbsp;
                        <asp:Label ID="" Style="border-bottom: 1px dotted grey" runat="server">@Model.Transaction.PropertyName</asp:Label>
                        -
                        <asp:Label Style="border-bottom: 1px dotted grey" ID="" runat="server">@Model.ContractVM.BuildingNumber</asp:Label>
                    </td>
                    <td></td>
                    <td></td>
                </tr>

                <tr id="trUnits" runat="server">
                    <td style="line-height: 20px">
                        @* <b>Unit No.</b>*@
                    </td>
                    <td>
                        :&nbsp;&nbsp;
                        @* <asp:Label ID="lblUnit" Style="border-bottom: 1px dotted grey" runat="server"></asp:Label>*@
                    </td>
                    <td></td>
                    <td></td>
                </tr>
                <tr id="trContractNo" runat="server">
                    <td style="line-height: 20px; width: 100px">
                        <b>
                            <asp:Label ID="lblForAction" runat="server" Text="Contract No">Contract No</asp:Label>>
                        </b>
                    </td>
                    <td>
                        :&nbsp;&nbsp;
                        <asp:Label ID="lblContractNo" Style="border-bottom: 1px dotted grey" runat="server">@Model.ContractVM.Contractno</asp:Label>
                    </td>
                    <td></td>
                    <td></td>
                </tr>


                <tr id="trTenant" runat="server" visible="false">
                    <td style="line-height: 20px">
                        <b>Tenant Name</b>
                    </td>
                    <td>
                        :&nbsp;&nbsp;
                        <asp:Label ID="" Style="border-bottom: 1px dotted grey" runat="server">@Model.ContractVM.Name</asp:Label>
                    </td>
                    <td></td>
                    <td></td>
                </tr>

                <tr id="trPeriod" runat="server">
                    <td style="line-height: 20px; width: 100px">
                        <b>
                            <asp:Label ID="" runat="server" Text="Period">Period</asp:Label>
                        </b>
                    </td>
                    <td>
                        :&nbsp;&nbsp;
                        <asp:Label ID="" Style="border-bottom: 1px dotted grey" runat="server">@Model.ContractVM.fromDate to @Model.ContractVM.ToDate</asp:Label>
                    </td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td colspan="2">
                        <br />
                    </td>
                </tr>
                <tr id="ChequesTable" runat="server">
                    <td colspan="4">
                        <table style="border: 1px dotted grey" id="chkTable" cellpadding="2" cellspacing="2"
                               width="60%">
                            <tr>
                                <td>
                                    <b>Cheque</b>
                                </td>
                                <td>
                                    <b>Date</b>
                                </td>
                                <td>
                                    <b>Bank</b>
                                </td>
                                <td></td>
                                <td>
                                    <b>AED</b>
                                </td>
                            </tr>


                            @foreach (var item in Model.Cheques)
                            {
                                <tr>
                                    <td>@item.ChequeNo</td>
                                    <td>@item.ChequeDate</td>
                                    <td>@item.BankName</td>
                                    <td></td>
                                    <td>@item.ChequeAmount</td>
                                </tr>
                            }

                            <tr>

                                <td>
                                    <b>Total</b>
                                </td>
                                <td>
                                    <b>
                                        <asp:Label ID="lblTotalAmount" Style="border-bottom: 1px dotted grey" runat="server"></asp:Label>
                                    </b>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>


                <tr id="tr1" runat="server">
                    <td style="line-height: 20px">
                        <b>Description</b>
                    </td>
                    <td>
                        :&nbsp;&nbsp;
                        <asp:Label ID="lblDescription" Style="border-bottom: 1px dotted grey" runat="server">@Model.Transaction.Description</asp:Label>
                    </td>
                    <td></td>
                    <td></td>
                </tr>
                @* <tr id="tr2" runat="server">
                    <td style="line-height: 20px">
                    <b><i>Prepared By</i></b>
                    </td>
                    <td>
                    :&nbsp;&nbsp;
                    <asp:Label ID="lblPrepareddBy" Style="border-bottom: 1px dotted grey" runat="server">@Model.Transaction.PreparedBy</asp:Label>
                    </td>
                    <td></td>
                    <td></td>
                    </tr>*@

                <tr>
                    <td></td>
                </tr>
                <tr>
                    <td></td>
                </tr>
                <tr>
                    <td colspan="4">
                        Note: Payments made by Cheque are subjected to realization.
                    </td>
                </tr>
                <tr>
                    <td colspan="4">
                        <strong>*This is the system generated document, doesnot require any signature*</strong>
                    </td>
                </tr>

            </table>
        </div>

    </form>
</body>
</html>
