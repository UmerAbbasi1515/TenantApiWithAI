@model FABTenantApi.Models.OfferLetterVm

<p>
    <img style="display: block; margin-left: auto; margin-right: auto;" src="data:image/png;base64," />
</p>

<h4 style="text-align:center; text-decoration:underline; font-size:25px;">Tenant Offer Letter</h4>
<div style="padding-left:20px">


    <p>Date : @DateTime.UtcNow.AddHours(4).ToString("MMM dd, yyyy")</p>
    <p>This offer letter is issued at the request of the tenant without any responsibility for the company based on the below information: -</p>
    <table style="height: 5px;" width="100%">
        <tbody>
            <tr>
                <td style="width:30%">
                    1. Tenant Name :
                </td>
                <td style="width:70%">@Model.TenantName</td>
            </tr>
            <tr>
                <td style="width:30%">
                    2.	Building Name :
                </td>
                <td style="width:70%">@Model.PropertyName</td>
            </tr>
            <tr>
                <td style="width:30%">
                    3.	Unit Number :
                </td>
                <td style="width:70%">@Model.UnitRefNo</td>
            </tr>
            <tr>
                <td style="width:30%">
                    4.	No of Bedrooms :
                </td>
                <td style="width:70%"> @Model.UnitID </td>
            </tr>
            <tr>
                <td style="width:30%">
                    5.	Annual Rent :
                </td>
                <td style="width:70%"> AED @Model.TotalPayable </td>
            </tr>
            <tr>
                <td style="width:30%">
                    6.	Period :
                </td>
                <td style="width:70%"> @Model.fromDate  @Model.ToDate </td>
            </tr>
            <tr>
                <td style="width:30%">
                    7.	Renewal Fees :
                </td>
                <td style="width:70%"> AED 550 </td>
            </tr>
        </tbody>
    </table>

    <p>&nbsp;</p>
    <p>All payments must be in favor of “FAB Properties”. Please find below the bank details.</p>
    <div style="border: 1px solid black;">
        <table style="height: 144px;" width="100%">
            <tbody>
                <tr>
                    <td style="width: 99.5139px;">Beneficiary name:</td>
                    <td style="width: 99.5139px;">First Abu Dhabi Properties - Rent</td>
                </tr>
                <tr>
                    <td style="width: 99.5139px;">Beneficiary Bank:</td>
                    <td style="width: 99.5139px;">First Abu Dhabi Bank, Abu Dhabi, U.A.E</td>
                </tr>
                <tr>
                    <td style="width: 99.5139px;">Beneficiary A/c No:</td>
                    <td style="width: 99.5139px;">AED 101-120-1492257-096</td>
                </tr>
                <tr>
                    <td style="width: 99.5139px;">Beneficiary Bank SWIFT:</td>
                    <td style="width: 99.5139px;">NBADAEXXX</td>
                </tr>
                <tr>
                    <td style="width: 99.5139px;">IBAN No.:</td>
                    <td style="width: 99.5139px;">AE340351011201492257096</td>
                </tr>
                <tr>
                    <td style="width: 99.5139px;">Branch:</td>
                    <td style="width: 99.5139px;">Salam Branch, Abu Dhabi</td>
                </tr>
            </tbody>
        </table>
    </div>
    <p>
        • This  letter is valid for 30 Days from the day of issuance.
    </p>
    <p>
        Regards,

    </p>
    <p style="font-size:20px; font-weight:500">
        FAB Properties
    </p>
    <p>
        This is a system generated letter which does not require signature
    </p>
</div>
