@model FABTenantApi.Controllers.ImagesController.CheckImage
@{
    ViewData["Title"] = "Test SMS";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>FAB SMS App</title>

    
    <!-- App CSS -->
    <style>
        .label-danger {
            color: orangered;
        }

        .label-success {
            color: forestgreen;
        }
    </style>
</head>
<body>
    <header>
        
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <div style="border:1px solid black;">
                <h3> Property Image</h3>
            @if(Model.ImageByte!=null)
            {
                string imreBase64Data = Convert.ToBase64String(@Model.ImageByte);
                 <span>@string.Format("data:image/png;base64,{0}", imreBase64Data)</span>
            }
            <br />
            <br />
           <a herf="/mnt/azure/Propertyimages/1.jpg" class="btn btn-primary">Image Path: @Model.Path</a>
           </div>
           
            
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2022  - FAB App
        </div>
    </footer>
    

    <script>
        $.validator.unobtrusive.parse('#SendSMSForm')
        function onSendSMSBegin(req) {

            $('#btnSendSMS').html("<span class='spinner-border spinner-border-sm' role='status' aria-hidden='true' style='margin-right:5px;'></span> Processing");

        }
        function onSendSMSSuccess(req) {
            if (req.response == 'Success') {
                $("#messagerowDiv").show();
                $("#messageDiv").html('<p class="label label-success">' + req.message + '</p>');
                $("#btnSendSMS").css('display', 'block');
                $('#btnSendSMS').html("Send SMS");
                $('#SMSText').val('');
                $('#Mobile').val('');
            }
            else if (req.response == 'Failed') {
                $("#btnSendSMS").css('display', 'block');
                $("#messagerowDiv").show();
                $("#messageDiv").html('<p class="label label-danger">' + req.message + '</p>');
                $('#btnSendSMS').html("Send SMS");
                
            }
            else {
                onSendSMSFailure(req);
            }
        }
        function onSendSMSFailure(req) {

            $("#messagerowDiv").show();
            $("#messageDiv").html('<p class="label label-danger">' + req.message + '</p>');
            $("#btnSendSMS").css('display', 'block');
            $('#btnSendSMS').html("Send SMS");
            
        }
    </script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

    <script>
        function GetMobileNumber()
        {
            var mobileNumber=$('#Mobile').val();
            let result = mobileNumber.replace("+971", "0");
            $('#NewNumber').html(result);
        }
        </script>
</body>
</html>
